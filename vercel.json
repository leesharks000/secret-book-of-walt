{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "secretbookofwalt.org"
        }
      ],
      "destination": "https://www.secretbookofwalt.org/:path*",
      "permanent": true
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true
}
